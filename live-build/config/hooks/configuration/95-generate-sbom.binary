# The jq programs passed to sbom_jq() below use jq's own $variables.
# shellcheck disable=SC2016

#
# Generate a CycloneDX SBOM for this image by scanning the populated
# "binary" directory (i.e. the appliance's root filesystem). The syft and
# cyclonedx-cli tools used here are build-host-only tooling, installed
# onto the build host by build-ancillary-repository.sh; they are never
# installed into the appliance itself.
#
# This hook lives in "configuration" (rather than "vm-artifacts") and is
# numbered above every other hook, so that it always runs, for every run
# type, and runs last. Both matter: build.gradle declares "*.cdx.json" as
# an output of the "upgrade-artifacts" run type, which never copies the
# "vm-artifacts" hooks; and running last means the SBOM reflects whatever
# every earlier hook (the apt cache cleanup, the hostname clearing, etc.)
# left behind in the "binary" directory.
#
# Only the dpkg cataloger is enabled: dpkg is the sole source that can
# authoritatively attribute a file on disk to the package that placed it
# there. Vendored/extracted third-party content bundled inside a larger
# installed package (jars, npm modules, Rust crates, etc.) isn't
# attributable this way, so language-level catalogers are left off here
# to avoid misattributing it; that content is covered separately by
# per-package SBOMs produced upstream in linux-pkg, which
# run-live-build.sh merges into this document once the image is built.
#
# SYFT_FILE_METADATA_SELECTION=none suppresses Syft's default behavior of
# emitting a separate CycloneDX "file" component (with SHA-1/SHA-256
# hashes) for every individual file owned by every cataloged package.
# That's unrelated to --select-catalogers (which only scopes *package*
# catalogers) and, left at its default, balloons the output to one
# "file" entry per file on the appliance -- tens of thousands of them --
# instead of the flat, per-package pkg:deb document this hook is meant to
# produce.
#
SYFT_FILE_METADATA_SELECTION=none syft scan dir:binary \
	--select-catalogers dpkg \
	--source-name "$ARTIFACT_NAME" \
	--source-version "$DELPHIX_APPLIANCE_VERSION" \
	-o "cyclonedx-json@1.6=$ARTIFACT_NAME.cdx.json"

#
# Post-process the document Syft produced, in the steps below, so that
# standard SBOM scanners can read all of it.
#
# One of the requirements for this SBOM is that it can be processed by
# standard scanners such as Mend, which is how it is checked for licenses and
# known vulnerabilities. Mend's importer adds these constraints to the format
# that Syft's output does not meet as is:
#
#  - The root component (metadata.component) must be typed "application", or
#    Mend does not treat it as the project root.
#  - Every license "id" must be on Mend's list of SPDX identifiers, which is
#    shorter than the real SPDX list, or Mend rejects the whole document.
#  - Every component must be reachable from the root through the
#    "dependencies" array, which Mend walks to build its tree; it drops
#    anything it does not reach.
#  - Each Delphix product must be depended on by the root alone, because Mend
#    groups findings under its "direct libraries": the components that nothing
#    but the root depends on.
#
# Each step is a separate jq command that rewrites the document in place.
#
sbom="$ARTIFACT_NAME.cdx.json"

function sbom_jq() {
	jq "$@" "$sbom" >"$sbom.tmp"
	mv "$sbom.tmp" "$sbom"
}

#
# Type the root "application". Syft types it by what it scanned, and scanning
# a directory makes it "file". This is done here, where the document is
# produced, rather than when per-package SBOMs are merged into it later
# (scripts/merge-package-sboms.sh), so that it holds for every image,
# including one with nothing to merge.
#
sbom_jq '.metadata.component.type = "application"'

#
# Carry license ids that Mend does not know as free-text names, which
# CycloneDX allows. These are valid SPDX ids that Debian's copyright files use
# (SMAIL-GPL on debianutils, Artistic-dist on perl). Add to this list if Mend
# reports another.
#
sbom_jq '
	["SMAIL-GPL", "Artistic-dist"] as $unknown_to_mend
	| .components |= map(
		if .licenses then
			.licenses |= map(
				if .license.id and (.license.id | IN($unknown_to_mend[]))
				then .license = {name: .license.id}
				else . end)
		else . end)'

#
# Drop every Depends: edge into a delphix-* package, so that the next step
# makes each product a dependency of the root alone. The products otherwise
# chain (delphix-masking depends on delphix-virtualization, which depends on
# delphix-sso-app and delphix-platform-aws, ...), and Mend listed only
# delphix-masking as a direct library, with every product's findings under it.
# The cost is that the document no longer records which product depends on
# which. Each product's edges to other packages are kept.
# scripts/merge-package-sboms.sh does the same for each package it merges
# bundled components into.
#
sbom_jq '
	.metadata.component["bom-ref"] as $root
	| [.components[] | select((.name | startswith("delphix-"))
	                          and (.purl // "" | startswith("pkg:deb/")))
	   | .["bom-ref"]] as $products
	| .dependencies //= []
	| .dependencies |= map(if .ref == $root or .dependsOn == null then .
		else .dependsOn |= map(select(IN($products[]) | not)) end)'

#
# Make the root depend on every component that nothing else depends on.
# Syft records only the Depends: edges between packages and gives the root no
# entry, so these (dash, host-jdks, delphix-entire-aws, ...) are otherwise
# unreachable. Also give each component Syft left out of the array an empty
# entry of its own.
#
sbom_jq '
	.metadata.component["bom-ref"] as $root
	| ([.dependencies[] | select(.ref != $root) | .dependsOn[]?]
	   | unique) as $children
	| ([.dependencies[].ref] | unique) as $listed
	| [.components[]["bom-ref"]] as $top
	| .dependencies = [.dependencies[] | select(.ref != $root)]
		+ [{ref: $root, dependsOn:
			[$top[] | select(IN($children[]) | not)]}]
		+ [$top[] | select(IN($listed[]) | not) | {ref: ., dependsOn: []}]'

#
# Connect packages that depend on each other in a closed loop with nothing
# outside depending on them, which the previous step misses: in internal-dev,
# ldap-auth-client, libpam-ldap, ldap-auth-config and libnss-ldap each have a
# parent, but only within that loop. While some component is unreachable from
# the root, make the root depend on the first such one; one edge per loop is
# enough to bring the whole loop in.
#
sbom_jq '
	def reachable($g; $from):
		{seen: {($from): true}, todo: [$from]}
		| until(.todo == [];
			.seen as $s
			| ([.todo[] | $g[.][]?] | unique
			   | map(select($s[.] | not))) as $new
			| .seen += (reduce $new[] as $n ({}; .[$n] = true))
			| .todo = $new)
		| .seen;
	.metadata.component["bom-ref"] as $root
	| [.components[]["bom-ref"]] as $top
	| def unreached:
		(reduce .dependencies[] as $e ({}; .[$e.ref] = $e.dependsOn))
			as $g
		| reachable($g; $root) as $s
		| [$top[] | select($s[.] | not)] | first;
	  until(unreached == null;
		unreached as $c
		| .dependencies |= map(if .ref == $root
			then .dependsOn += [$c] else . end))'

cyclonedx-cli validate \
	--input-file "$sbom" \
	--input-format json \
	--input-version v1_6 \
	--fail-on-errors
