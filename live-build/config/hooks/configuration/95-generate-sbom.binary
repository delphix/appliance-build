#
# Generate a CycloneDX SBOM for this image by scanning the populated
# "binary" directory (i.e. the appliance's root filesystem). The syft and
# cyclonedx-cli tools used here are build-host-only tooling, installed
# onto the build host by build-ancillary-repository.sh; they are never
# installed into the appliance itself.
#
# This hook lives in "configuration" (rather than "vm-artifacts") and is
# numbered above every other hook, so that it always runs, for every run
# type, and runs last. Both matter: build.gradle declares "*.cdx.json" as
# an output of the "upgrade-artifacts" run type, which never copies the
# "vm-artifacts" hooks; and running last means the SBOM reflects whatever
# every earlier hook (the apt cache cleanup, the hostname clearing, etc.)
# left behind in the "binary" directory.
#
# Only the dpkg cataloger is enabled: dpkg is the sole source that can
# authoritatively attribute a file on disk to the package that placed it
# there. Vendored/extracted third-party content bundled inside a larger
# installed package (jars, npm modules, Rust crates, etc.) isn't
# attributable this way, so language-level catalogers are left off here
# to avoid misattributing it; that content is covered separately by
# per-package SBOMs produced upstream in linux-pkg, which
# run-live-build.sh merges into this document once the image is built.
#
# SYFT_FILE_METADATA_SELECTION=none suppresses Syft's default behavior of
# emitting a separate CycloneDX "file" component (with SHA-1/SHA-256
# hashes) for every individual file owned by every cataloged package.
# That's unrelated to --select-catalogers (which only scopes *package*
# catalogers) and, left at its default, balloons the output to one
# "file" entry per file on the appliance -- tens of thousands of them --
# instead of the flat, per-package pkg:deb document this hook is meant to
# produce.
#
SYFT_FILE_METADATA_SELECTION=none syft scan dir:binary \
	--select-catalogers dpkg \
	--source-name "$ARTIFACT_NAME" \
	--source-version "$DELPHIX_APPLIANCE_VERSION" \
	-o "cyclonedx-json@1.6=$ARTIFACT_NAME.cdx.json"

#
# Syft types the document's root component by what it scanned, and scanning
# a directory makes it "file". Mend's support team stated that their importer
# only treats metadata.component as the project root when it is typed
# "application", so retype it here. This is done where the document is
# produced, rather than when per-package SBOMs are merged into it later
# (scripts/merge-package-sboms.sh), so that it holds for every image --
# including one with nothing to merge -- and the merged document simply
# inherits it.
#
#
# Mend also rejects the whole document if a license "id" isn't on its own list
# of SPDX identifiers, which is shorter than the real SPDX list. These two are
# valid SPDX ids that Debian's copyright files use (SMAIL-GPL on debianutils,
# Artistic-dist on perl), so carry them as free-text license names instead,
# which CycloneDX allows. Add to this list if Mend reports another.
#
# Mend builds its dependency tree by walking the "dependencies" array from
# the root, but Syft never gives the root an entry there: it records only the
# Depends: edges between packages. Every package that nothing else depends on
# (dash, host-jdks, delphix-entire-aws, ...) is therefore unreachable, and
# Mend drops it. So make the root depend on each such top-level component,
# and give any component Syft left out of the array an empty entry of its
# own. The existing Depends: edges are kept as Syft produced them, except
# for those into delphix-* packages (below).
#
# That still misses packages that depend on each other in a closed loop with
# nothing outside depending on them: in internal-dev, ldap-auth-client,
# libpam-ldap, ldap-auth-config and libnss-ldap each have a parent, but only
# within that loop. So walk the graph from the root and, while some component
# is still unreachable, make the root depend on the first such one; one edge
# per loop is enough to bring the whole loop in.
#
# Every delphix-* package is also made a direct dependency of the root, and
# of the root alone: the Depends: edges from other packages to it are
# dropped. The products otherwise chain (delphix-masking depends on
# delphix-virtualization, which depends on delphix-sso-app and
# delphix-platform-aws, ...), and Mend groups findings under the project's
# "direct libraries", which it takes to be the components that nothing but
# the root depends on; even with root edges to every product, it listed only
# delphix-masking, with every product's findings under it. The cost is that
# the document no longer records which product depends on which. Each
# product's edges to other packages, and to its own bundled components, are
# kept. scripts/merge-package-sboms.sh does the same for each package it
# merges bundled components into.
#
jq '
	def reachable($g; $from):
		{seen: {($from): true}, todo: [$from]}
		| until(.todo == [];
			.seen as $s
			| ([.todo[] | $g[.][]?] | unique
			   | map(select($s[.] | not))) as $new
			| .seen += (reduce $new[] as $n ({}; .[$n] = true))
			| .todo = $new)
		| .seen;
	["SMAIL-GPL", "Artistic-dist"] as $unknown_to_mend
	| .metadata.component.type = "application"
	| .dependencies //= []
	| .metadata.component["bom-ref"] as $root
	| [.components[] | select((.name | startswith("delphix-"))
	                          and (.purl // "" | startswith("pkg:deb/")))
	   | .["bom-ref"]] as $products
	| .dependencies |= map(if .ref == $root or .dependsOn == null then .
		else .dependsOn |= map(select(IN($products[]) | not)) end)
	| ([.dependencies[] | select(.ref != $root) | .dependsOn[]?]
	   | unique) as $children
	| ([.dependencies[].ref] | unique) as $listed
	| [.components[]["bom-ref"]] as $top
	| .dependencies = [.dependencies[] | select(.ref != $root)]
		+ [{ref: $root, dependsOn:
			[$top[] | select(IN($children[]) | not)]}]
		+ [$top[] | select(IN($listed[]) | not) | {ref: ., dependsOn: []}]
	| def unreached:
		(reduce .dependencies[] as $e ({}; .[$e.ref] = $e.dependsOn))
			as $g
		| reachable($g; $root) as $s
		| [$top[] | select($s[.] | not)] | first;
	  until(unreached == null;
		unreached as $c
		| .dependencies |= map(if .ref == $root
			then .dependsOn += [$c] else . end))
	| .components |= map(
		if .licenses then
			.licenses |= map(
				if .license.id and (.license.id | IN($unknown_to_mend[]))
				then .license = {name: .license.id}
				else . end)
		else . end)
' "$ARTIFACT_NAME.cdx.json" >"$ARTIFACT_NAME.cdx.json.tmp"
mv "$ARTIFACT_NAME.cdx.json.tmp" "$ARTIFACT_NAME.cdx.json"

cyclonedx-cli validate \
	--input-file "$ARTIFACT_NAME.cdx.json" \
	--input-format json \
	--input-version v1_6 \
	--fail-on-errors
