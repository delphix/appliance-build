#
# Fail the build if this image ships a credential: one in /etc/environment, or
# one in the remote URL of a git checkout baked into the image.
#
# This hook lives in "configuration" and is numbered above every other hook so
# that it runs for every run type, and runs last, after every hook that writes
# into the "binary" directory. See 95-generate-sbom.binary for why that placement
# matters.
#
# It fails rather than warns: a published image cannot be un-published, so the
# build is the last place a credential can be stopped. On a vm-artifacts run
# the disk images are already written when this runs; failing here is what
# keeps them from being published.
#
# Everything it reports is a file name and a redacted match. The build log is
# readable by far more people than the credential is.
#

status=0

#
# pam_env reads /etc/environment on every login and needs it world-readable to do
# so, which makes the file readable by every user of every VM cloned from this
# image. A credential written there is a credential handed to all of them.
#
# AWS_DEFAULT_REGION and the rest of the AWS_* namespace are configuration, not
# secrets, and are fine to ship. Match only the variables that carry one.
#
environment_file="binary/etc/environment"
environment_pattern='^[[:space:]]*(export[[:space:]]+)?AWS_(ACCESS_KEY_ID|SECRET_ACCESS_KEY|SESSION_TOKEN|SECURITY_TOKEN)='

if [[ -f $environment_file ]] && grep -qE "$environment_pattern" "$environment_file"; then
	echo "error: this image ships an AWS credential in /etc/environment:" >&2
	grep -nE "$environment_pattern" "$environment_file" |
		sed 's/=.*/=<redacted>/' >&2
	status=1
fi

#
# git writes a clone's URL into the checkout's own config, so cloning with
# "https://$TOKEN@github.com/..." leaves the token in the image. An ansible role
# that clones that way has to reset the remote afterwards, as
# appliance-build.virtualization-development does. The same URL can also sit in
# a pushurl, in an insteadOf rewrite in a user's or the system gitconfig, or in
# git's credential store, so all of those are read too.
#
# The credential is an HTTP(S) URL's userinfo component, between the scheme and
# the host. A URL with no userinfo carries none, and neither does an SSH remote:
# git never sends a password from one, so "ssh://git@..." is only a user name.
#
url_pattern='https?://[^/@[:space:]"]+@'

reported_a_url=false

while IFS= read -r -d '' git_file; do
	grep -qiE "$url_pattern" "$git_file" || continue

	if [[ $reported_a_url == false ]]; then
		echo "error: this image ships a credential in a git URL:" >&2
		reported_a_url=true
	fi
	grep -HniE "$url_pattern" "$git_file" |
		sed -E 's#(https?://)[^/@[:space:]"]+@#\1<redacted>@#gI' >&2
	status=1
done < <(find binary -type f \( \
	-path '*.git/config' -o \
	-path '*/.git/*' \( -name config -o -name config.worktree \) -o \
	-path '*/.config/git/config' -o \
	-path '*/.config/git/credentials' -o \
	-path binary/etc/gitconfig -o \
	-name .gitconfig -o \
	-name .git-credentials \) -print0)

if ((status != 0)); then
	echo "Remove whatever writes it, then build again." >&2
	exit 1
fi
